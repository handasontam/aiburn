{
	"compilerOptions": {
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"types": ["bun"],
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src"]
}
